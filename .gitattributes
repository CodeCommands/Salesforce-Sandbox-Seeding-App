# Windows scripts must keep CRLF line endings (cmd.exe mis-parses labels in LF-only .bat files)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
* text=auto
# macOS / Unix scripts must keep LF line endings (bash and perl reject CRLF shebang lines)
*.command text eol=lf
*.pl text eol=lf
*.sh text eol=lf
